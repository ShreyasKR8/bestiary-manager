<link rel="stylesheet" href="/css/styles.css">

<div class="monsters-of-type">
    <h1><%= monsterType.name %></h1>
    <h3><%= monsterType.description %></h3>
    <ul>
        <% monsters.forEach(monster => { %>
            <li>
                <a href="/monsters/<%= monster.id %>"><%= monster.name %></a>
            </li>
        <% }); %>
    </ul>
    <% if(monsterType.name != 'Uncategorized') { %>
        <form method="GET" action="/monster-types/<%= monsterType.id %>/edit">
            <button type="submit" class="edit-btn">Edit Info</button>
        </form>
        <form method="POST" action="/monster-types/<%= monsterType.id %>?_method=DELETE">
            <button type="submit" class="delete-btn" data-name="<%= monsterType.name %>">Delete Category</button>
        </form>
    <% } %>
</div>

<!-- Single reusable modal -->
<div id="confirmModal" class="hidden modal">
  <div class="modal-box">
    <p id="modalText">Are you sure?</p>
    <button id="confirmYes">Yes</button>
    <button id="confirmNo">Cancel</button>
  </div>
</div>

<script src="/js/deleteModal.js"></script>