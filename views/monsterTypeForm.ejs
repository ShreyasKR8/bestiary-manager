<h2>Add new monster type</h2>
<form method="POST" action="/monster-types">
    <label for="monsterType">Monster Type: </label>
    <input name="monsterType" type="text" id="monsterType" required>
    <label for="desc">Monster Type desc: </label>
    <input name="desc" type="text" id="desc" required>
    <button id="monsterType" type="submit">Add</button>
</form>