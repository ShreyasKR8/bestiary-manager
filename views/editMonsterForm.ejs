<link rel="stylesheet" href="/css/styles.css">

<div class="edit-monster-div">
    <h2 class="edit-heading">Edit <%= monsterData.name %></h2>
    <form method="POST" action="/monsters/<%= monsterData.id %>?_method=PUT">
        <label for="name">Name: </label>
        <input type="text" name="name" id="name" value="<%= monsterData.name %>">
        <label for="weaknesses">Weaknesses: </label>
        <input type="text" name="weaknesses" id="weaknesses" value="<%= monsterData.weakness %>">
        <label for="monsterType">Monster type: </label>
        <Select name="monsterType" id="monsterType">
            <% monsterTypes.map(type => { %>
                <% if(type.id == monsterData.monster_type_id) { %>
                    <option value="<%= type.id %>" selected><%= type.name %></option>
                <% }
                else { %>
                    <option value="<%= type.id %>"><%= type.name %></option>
                <% } %>
            <%}) %>
        </Select>
        <button id="edit-confirm-btn" type="submit">Confirm changes</button>
        <button type="button" 
            onclick="window.location.href='/monsters/<%= monsterData.id %>'" 
            class="edit-cancel-btn">
            Cancel
        </button>
    </form>
</div>
