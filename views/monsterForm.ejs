<link rel="stylesheet" href="/css/styles.css">

<div class="add-monster-form">
    <h2>Add new monster: </h2>
    <form method="POST" action="/monsters">
        <label for="name">Name</label>
        <input type="text" name="name" id="name">
        <label for="weaknesses">Weaknesses</label>
        <input type="text" name="weaknesses" id="weaknesses">
        <label for="monsterType">Monster type: </label>
        <Select name="monsterType" id="monsterType">
            <% monsterTypes.map(type => { %>
                <option value="<%= type.id %>"><%= type.name %></option>
            <%}) %>
        </Select>
        <button class="btn-primary" id="add-monsters" type="submit">Add</button>
    </form>
</div>
