<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bestiary Manager</title>
</head>
<body>
    <h1 style="text-align: center;"><%= title %></h1>
    <ul>
        <% monsterTypes.forEach(monsterType => { %>
            <li><a href="/monster-types/<%=monsterType.id %>/monsters"><%= monsterType.name %></a></li>
        <% }); %>
    </ul>
    <a href="/monster-types/new">Add new monster type</a>
    <a href="/monsters/new">Add new monster</a>
    <a href="/monsters/">All Monsters</a>
</body>
</html>