<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bestiary Manager</title>
</head>
<body>
    <h2><%= title %></h2>
    <ul>
        <% monsterTypes.forEach(monsterType => { %>
            <li><a><%= monsterType %></a></li>
        <% }); %>
    </ul>
</body>
</html>